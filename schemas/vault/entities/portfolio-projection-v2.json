{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invest-agents:vault:portfolio-projection:v2",
  "title": "Portfolio Projection v2",
  "allOf": [{"$ref": "../core/note-v2.json"}],
  "required": ["document_role", "portfolio_id", "search_scope"],
  "properties": {
    "document_role": {"const": "projection"},
    "portfolio_id": {"type": "string", "minLength": 1},
    "search_scope": {"const": "excluded"},
    "projection_of": {"const": "portfolio_transactions"},
    "source_checkpoint": {"type": "string", "minLength": 1},
    "source_content_hashes": {"type": "array", "items": {"type": "string"}}
  }
}
