# =========================================
# 📡 Model Keys
# =========================================

# Google Gemini — ขอได้ที่ https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude — ขอได้ที่ https://console.anthropic.com/ (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =========================================
# 📁 Path
# =========================================

# โฟลเดอร์ที่ใช้เก็บ Obsidian Vault (ค่าเริ่มต้น: ./memories)
OBSIDIAN_VAULT_PATH=./memories

# =========================================
# 🏷️ Branding
# =========================================

# ชื่อกองทุน — ใช้ใน Bookkeeper system prompt (ค่าเริ่มต้น: "กองทุนส่วนตัว")
FUND_NAME=กองทุนส่วนตัว

# =========================================
# 🤖 Model Selection (optional — uncomment to override defaults)
# =========================================
# Current defaults (agents/manager_agent.py):
#   ทุก agent → gemini-3.1-flash-lite-preview
#   Fallback chain (core/llm_factory.FALLBACK_MODEL) → openai/gpt-oss-120b:free (cross-provider)
#
# MANAGER_MODEL=gemini-3.1-flash-lite-preview
# ROUTER_MODEL=gemini-3.1-flash-lite-preview      # ตัวที่รัน with_structured_output (RouterDecision)
# ARCHIVIST_MODEL=gemini-3.1-flash-lite-preview
# RESEARCHER_MODEL=gemini-3.1-flash-lite-preview
# BOOKKEEPER_MODEL=gemini-3.1-flash-lite-preview
# YOUTUBE_PITCH_MODEL=gemini-3.1-flash-lite-preview # ตัวที่ใช้คัดสรรไอเดียคลิปและเขียน Briefing Book ให้ NotebookLM
# YOUTUBE_PITCH_PROVIDER=                          # ถ้าไม่ระบุ จะใช้ detect_provider() อัตโนมัติจากชื่อ YOUTUBE_PITCH_MODEL (google/anthropic/openrouter)
# NEWS_FUNNEL_TRIAGE_MODEL=gemini-3.1-flash-lite-preview # ตัวที่ประเมินคะแนนและแปลหัวข้อข่าวในระบบคัดกรองข่าว
# EXTRACTOR_MODEL=gemini-3.1-flash-lite-preview          # ตัวที่สกัดเนื้อหาจาก Article/PDF/YouTube Transcript
# NEWS_FUNNEL_SYNTHESIS_MODEL=gemini-3.1-flash-lite-preview # ตัวที่แปลหัวข้อข่าวเป็นภาษาไทย
# LLM_PROVIDER=google                              # override detect_provider() (claude/gemini/openrouter)
#
# ดูค่าที่ resolve จริงทั้งหมด (agent + tool layer) ได้ที่ GET /api/debug/models (ต้อง login ก่อน)
# — ดูนิยาม slot ทั้งหมดที่ core/model_registry.py

# Vault folders เพิ่มเติม (comma-separated) — เช่น 50_Crypto,60_Research/Drafts
# VAULT_EXTRA_FOLDERS=

# =========================================
# 📊 Data Sources
# =========================================

# FRED API — ขอได้ฟรีที่ https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# =========================================
# 🔭 LangSmith Observability (optional)
# =========================================

# เปิดใช้ LangSmith Tracing — ลบออกหรือตั้งเป็น false เพื่อปิด
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# LangSmith API Key — ขอได้ที่ https://smith.langchain.com/
LANGCHAIN_API_KEY=your_langsmith_api_key_here

# ชื่อ Project ใน LangSmith Dashboard
LANGCHAIN_PROJECT="Trinity-Wealth-Engine"

# =========================================
# 🌐 Web UI (FastAPI Controller — api/main.py)
# =========================================

# รหัสผ่านเดียวสำหรับ login เข้าเว็บ — ไม่มีระบบ user/role (เครื่องมือส่วนตัวคนเดียว)
WEBUI_PASSWORD=change_me_to_a_real_password

# secret สำหรับ sign session cookie — ต้องตั้งเป็นค่าคงที่ ห้ามปล่อยว่าง/สุ่มใหม่ทุกครั้ง
# ไม่งั้น session ทุกใบจะ invalid ทันทีที่ restart server (ขัดกับเป้าหมาย "login ครั้งเดียว")
SESSION_SECRET_KEY=change_me_to_a_long_random_string

# key เฉพาะสำหรับ sign token อนุมัติ Unverified Draft — ใช้ค่าสุ่มอย่างน้อย 32 bytes
# ห้ามใช้ SESSION_SECRET_KEY ซ้ำ และห้าม commit ค่าใช้งานจริง
UNVERIFIED_DRAFT_SIGNING_KEY=change_me_to_a_different_long_random_string

# path ของ SQLite DB (แยกกันโดยตั้งใจ — กัน agent run ที่รันหนักไป lock หน้า Kanban/Portfolio)
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
WEBUI_STATE_DB_PATH=data/webui_state.sqlite

# ตั้งเป็น 1 เมื่อ deploy หลัง HTTPS (reverse proxy / tunnel) — ให้ browser ส่ง session
# cookie เฉพาะบน https; localhost แบบ http ต้องปล่อยว่าง/0 ไม่งั้น login ไม่ติด
SESSION_COOKIE_SECURE=0

# =========================================
# 🎙️ NotebookLM MCP (notebooklm-mcp-cli)
# =========================================

# Path ไปยัง auth token / cookie ที่ `nlm login` สร้างไว้ (ค่าเริ่มต้นอยู่ที่ ~/.notebooklm/)
# NOTEBOOKLM_AUTH_DIR=~/.notebooklm

# =========================================
# 🔔 Discord Notifications (optional)
# =========================================

# Webhook URL สำหรับส่งสรุปข่าว High-Impact จาก News Funnel — ปล่อยว่างเพื่อปิดฟีเจอร์นี้
DISCORD_WEBHOOK_URL=

# ถ้าช่องปลายทางเป็น Forum channel ที่ตั้ง required tags ไว้ ต้องระบุ Tag ID 3 ระดับนี้ด้วย
# (หาได้จาก Discord: เปิด Developer Mode > Edit Channel > Tags > คลิกขวา tag > Copy Tag ID)
DISCORD_TAG_ID_ULTRA=
DISCORD_TAG_ID_HIGH=
DISCORD_TAG_ID_WARNING=

# 🎙️ Webhook URL สำหรับห้อง "นักข่าวส่วนตัว" (NotebookLM Podcast) — ถ้าไม่ระบุจะ fallback ไปใช้ DISCORD_WEBHOOK_URL
DISCORD_NOTEBOOKLM_WEBHOOK_URL=
DISCORD_NOTEBOOKLM_TAG_ID=
# ขนาดไฟล์สูงสุดที่อนุญาตให้อัปโหลดเข้า Discord (Bytes) — Default: 7864320 (7.5 MiB Safe Margin)
DISCORD_MAX_AUDIO_BYTES=7864320

